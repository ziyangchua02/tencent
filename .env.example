# Copy to .env and fill in. .env is git-ignored and only the server reads it.

# Google Gemini reads the engineer's comments. Without a key, the offline rules read them instead.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
GEMINI_TIMEOUT_MS=20000

# Production server only (npm start). Dev uses 127.0.0.1:5173 unless HOST/PORT are set in the shell.
DB_PATH=data/pills.db

# Notification emails through Resend (https://resend.com). Without a key, no email is sent.
# Without a verified domain, Resend's test sender only delivers to the address you signed up with.
RESEND_API_KEY=
# EMAIL_FROM=Intelligence Pills <pills@your-verified-domain.com>
# Starting addresses for each role; each person can change theirs on the profile page.
MANAGER_EMAIL=
ENGINEER_EMAIL=
# Links in emails use the address the request came in on; set this to override it.
# APP_URL=https://your-app.onrender.com
