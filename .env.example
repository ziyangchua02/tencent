# Copy to .env and fill in. Every value is optional: with no LLM key the app runs fully
# offline (local embeddings + extractive answer composer), which is the safe demo fallback.

# --- LLM: Tencent TokenHub (Singapore / international endpoint, OpenAI-compatible) ---
# LLM_PROVIDER=auto uses the API when LLM_API_KEY is set, otherwise the offline composer.
LLM_PROVIDER=auto
LLM_BASE_URL=https://tokenhub-intl.tencentcloudmaas.com/v1
LLM_API_KEY=
LLM_MODEL=hy3                      # or hy4-preview (reasoning, 1M context)
LLM_TEMPERATURE=0.1
LLM_JSON_MODE=true                 # auto-disables itself if the endpoint rejects response_format

# Alternatives (same code path, just change these three lines):
#   Hunyuan direct (China site): LLM_BASE_URL=https://api.hunyuan.cloud.tencent.com/v1  LLM_MODEL=hunyuan-turbos-latest
#   Local Ollama (offline):      LLM_PROVIDER=openai_compatible  LLM_BASE_URL=http://localhost:11434/v1  LLM_API_KEY=ollama  LLM_MODEL=qwen2.5:7b
#   OpenAI:                      LLM_BASE_URL=https://api.openai.com/v1  LLM_MODEL=gpt-4.1-mini

# --- Embeddings ---
# local = BAAI/bge-small-en-v1.5 on CPU (downloads ~65 MB once); hash = zero-download fallback.
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
# To use TokenHub embeddings instead (re-indexes automatically on next start):
#   EMBEDDING_PROVIDER=openai_compatible
#   EMBEDDING_MODEL=kinfra-text-embedding-0.6b
#   (EMBEDDING_BASE_URL / EMBEDDING_API_KEY default to the LLM values)
# Optional similarity calibration overrides for a new embedding model:
#   SIM_FLOOR=0.35  SIM_CEILING=0.80  MIN_RELEVANCE=0.50

# --- Storage ---
# DATABASE_URL=postgresql+psycopg://user:pass@host:5432/kbridge   # default: SQLite in data/store
AUTO_SEED=true                     # ingest the synthetic corpus on first start
PII_REDACTION=true

# --- Frontend ---
KB_API_URL=http://localhost:8000
